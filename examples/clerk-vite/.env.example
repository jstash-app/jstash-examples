# Copy this file to .env.local and fill in both values. Neither is a secret:
# both end up in the page that every visitor's browser loads.

# Your jstash app's ID (app_…): it's under the app's name in Apps in the jstash dashboard.
VITE_JSTASH_APP_ID=

# Clerk Dashboard → API keys → Publishable key (pk_test_… for a development instance).
VITE_CLERK_PUBLISHABLE_KEY=
