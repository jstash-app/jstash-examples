# Copy this file to .env.local and fill in all three values. None is a secret:
# they all end up in the page that every visitor's browser loads.

# Your jstash app's ID (app_…): it's under the app's name in Apps in the jstash dashboard.
VITE_JSTASH_APP_ID=

# Supabase: the Connect button in your project shows both. The Project URL
# looks like https://abcd1234.supabase.co. The publishable key starts with
# sb_publishable_ (an older project's anon key works too).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
